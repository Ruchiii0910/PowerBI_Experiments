table Sheet1
	lineageTag: fcce96f6-250a-4578-fbe9-4499dbc080fd

	measure Total_Revenue = SUM(Sheet1[Revenue])
		formatString: #,0
		lineageTag: cc6b66e5-402a-df9c-8a4b-8f7c21472a15

	measure Predicted_Future_Sales =
			VAR n = COUNTROWS(Sheet1)
			VAR sx = SUM(Sheet1[Marketing_Spend])
			VAR sy = SUM(Sheet1[Revenue])
			VAR sxy = SUMX(Sheet1, Sheet1[Marketing_Spend] * Sheet1[Revenue])
			VAR sxx = SUMX(Sheet1, Sheet1[Marketing_Spend] ^ 2)
			VAR slope = DIVIDE(n * sxy - sx * sy, n * sxx - sx ^ 2)
			VAR intercept = DIVIDE(sy - slope * sx, n)
			VAR avgSpend = DIVIDE(sx, n)
			RETURN intercept + slope * avgSpend * (1 + [Spend Growth% Value])
		formatString: #,0
		lineageTag: ddcf8766-a93b-12cd-1c24-220e2cabd7e7

	column Date
		dataType: dateTime
		formatString: dd mmm yyyy
		lineageTag: 5bb5c40c-03cd-e2e3-21bd-db4106998731
		summarizeBy: none
		sourceColumn: Date

	column Marketing_Spend
		dataType: double
		lineageTag: 96bf10ab-3ce9-15e7-c9d6-a63bca3c6f5f
		summarizeBy: sum
		sourceColumn: Marketing_Spend

	column Revenue
		dataType: double
		lineageTag: 43ef2016-2c9b-662e-040a-3aae52e2afd9
		summarizeBy: sum
		sourceColumn: Revenue

	partition Sheet1 = m
		mode: import
		source =
				let

table Market_Basket_Data
	lineageTag: e7e646c7-0158-2463-9d87-76a072d78bdd

	measure Orders_Both_A_and_B =
			VAR OrdersA = VALUES(Market_Basket_Data[OrderID])
			VAR B = SELECTEDVALUE(Product_B[ProductB_Name])
			VAR OrdersB = CALCULATETABLE(VALUES(Market_Basket_Data[OrderID]), Market_Basket_Data[ProductName] = B)
			RETURN IF(ISBLANK(B), BLANK(), COUNTROWS(INTERSECT(OrdersA, OrdersB)))
		formatString: #,0
		lineageTag: 3735262d-4184-3b03-04dd-7054144823f7

	measure Confidence = DIVIDE([Orders_Both_A_and_B], COUNTROWS(VALUES(Market_Basket_Data[OrderID])))
		formatString: 0.0%
		lineageTag: f0b2a5d1-8c7e-6f42-2646-eaf9d5c0244d

	column OrderID
		dataType: int64
		lineageTag: 6c5a6c93-871c-0884-9bdf-90f2ba2c0f19
		summarizeBy: none
		sourceColumn: OrderID

	column ProductName
		dataType: string
		lineageTag: 3cd5fd7f-49c1-0669-c6b3-3fe61c76bdf6
		summarizeBy: none
		sourceColumn: ProductName


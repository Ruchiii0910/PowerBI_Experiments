table Customer_Churn
	lineageTag: 1ba362e7-afa4-15e5-6d20-449666d06371

	measure 'Total Customers' = DISTINCTCOUNT(Customer_Churn[CustomerID])
		formatString: #,0
		lineageTag: 718d4d05-e8e2-2743-b65f-eea97d824264

	measure 'Churned Customers' = CALCULATE(COUNTROWS(Customer_Churn), Customer_Churn[Churn] = "Yes")
		formatString: #,0
		lineageTag: 5275eb94-14ae-af5c-e636-58c912d0498d

	measure 'Churn Rate' = DIVIDE([Churned Customers], [Total Customers])
		formatString: 0.0%
		lineageTag: 204e178c-10d0-8d11-25f9-34bf9bb96155

	column CustomerID
		dataType: string
		lineageTag: 95da75c1-a211-50f9-9fd3-4579466772ce
		summarizeBy: none
		sourceColumn: CustomerID

	column Tenure
		dataType: int64
		lineageTag: 6182f347-533f-5a72-b64f-a54a8c611654
		summarizeBy: sum
		sourceColumn: Tenure

	column MonthlyCharges
		dataType: double
		lineageTag: 4b7e6b3c-87d2-92a6-98ee-ac2bfe9fecaa
		summarizeBy: sum
		sourceColumn: MonthlyCharges

	column Contract
		dataType: string
